# Content source: LOCAL (design-package bundles, Phase A) or OPS (Operations CMS, Phase B)
CONTENT_SOURCE=LOCAL
OPS_API_URL=https://operations.jobsadmire.com
OPS_WEBSITE_READ_TOKEN=
OPS_WEBSITE_WRITE_TOKEN=
# Test-class door token (wst_…): the T15 synthetic-lead cron and write-class smoke on Preview only —
# never a real lead (isTest, dry-run handlers). Consumed by `npm run door:smoke` and
# `e2e/door-test-mode.spec.ts` since T14, and by the T15 synthetic-lead cron.
OPS_WEBSITE_TEST_TOKEN=
# Vercel Cron bearer secret (W172): Vercel sends `Authorization: Bearer $CRON_SECRET` on every
# cron invocation; /api/cron/synthetic-lead answers 401 without it (unset or < 16 chars keeps the
# route shut). A random value of 16+ chars: Production, plus the `staging` Preview scope for the
# one manual proof.
CRON_SECRET=
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.jobsadmire.com

# Vercel "Protection Bypass for Automation" secret (Deployment Protection panel) — read by
# playwright.config.ts, scripts/gate.sh (lhci --settings.extraHeaders) and
# scripts/pixel-compare.ts to reach a protected preview (W91). Operator-side only: never a project
# variable, never a value committed here; export it in the shell that runs the gate against a
# preview.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Local-only: caps Next's static-generation workers on a shared machine (memory rule). Unset on
# Vercel, where the build should use its own default worker count.
# NEXT_BUILD_CPUS=2

# Public analytics identifiers (R54). These ship in the page source by nature of how GTM/GA4/Ads
# and Turnstile work — config values, not secrets. They overlay the LOCAL bundle's nulls, which is
# how Phase A turns analytics on; under CONTENT_SOURCE=OPS the CMS owns them instead (D12).
# Unset or empty = "not configured" = analytics stays dark.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
