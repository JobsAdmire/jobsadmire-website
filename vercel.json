{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run verify && next build",
  "installCommand": "npm ci --include=dev",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/synthetic-lead",
      "schedule": "0 6 * * *"
    }
  ]
}
