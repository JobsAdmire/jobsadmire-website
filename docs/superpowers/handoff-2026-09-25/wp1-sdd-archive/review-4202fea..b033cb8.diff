+  "jt.064": "Tam CRM erişimi, kendi paneliniz ve hedefleriniz",
+  "jt.065": "Sitemizde resmî temsilci olarak listelenme",
+  "jt.066": "Ek iş fırsatı",
+  "jt.067": "Yarı zamanlı koordinatör",
