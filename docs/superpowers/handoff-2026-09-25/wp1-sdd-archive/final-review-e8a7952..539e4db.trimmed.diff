+    },
+    {
+      id: 'contact',
+      heading: t('home.191'),
+      body: (
+        <div className="flex flex-col gap-1">
+          <a href={telLink(settings.phone)} className={FLINK}>
+            {settings.phoneDisplay}
+          </a>
+          <a href={mailLink(settings.email)} className={FLINK}>
