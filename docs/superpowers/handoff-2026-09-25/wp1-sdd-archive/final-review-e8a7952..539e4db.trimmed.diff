+/** The public routes the gate sweeps (axe, Lighthouse, SEO). WP2 appends every page as it
+ *  lands. `scripts/gate.sh` carries the same paths by hand for Lighthouse — keep them in sync. */
+export const GATE_ROUTES = [
+  '/',
+  '/en',
+  '/isci-talebi',
+  '/en/hire-workers',
+  '/tesekkurler?form=hire',
+];
