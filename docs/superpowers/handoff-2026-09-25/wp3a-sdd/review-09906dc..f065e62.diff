+    }
+  };
+
+  // RC26: a FAILED row is either the visitor's own mistake (the handler said so,
+  // no alarm rang) or an infrastructure failure (the alarm did ring). The banner
+  // must say which, because the fix is different — reply to the visitor vs.
+  // repair the service and re-run. The core stamps `handlerResultJson.visitorError`
+  // while the LAST attempt was the visitor's, and the attempt itself carries
+  // `detail.visitorError` — either spelling is honoured.
+  const isVisitorError = (row: WebsiteFormSubmission): boolean => {
+    const result = row.handlerResultJson;
+    if (!result) return false;
