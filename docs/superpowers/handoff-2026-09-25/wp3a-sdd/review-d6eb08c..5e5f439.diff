@@ -0,0 +1,42 @@
+// apps/backend/src/modules/website/website-redis-timeout.ts
+/**
+ * A bounded wait for the Redis calls on the intake door's HOT PATH (WP3a final
+ * review, Minor 6).
+ *
+ * `RedisService` runs ioredis with its defaults — offline queue on,
+ * `maxRetriesPerRequest` 20 — so a command issued while Redis is down rejects
+ * only after ≈10 s of reconnect back-off. One public POST asks Redis three
+ * times (`isTripped`, `recordVerified`, the alarm SETNX): 20–30 s before the
+ * fail-open path can answer, long after the website's server action has given
+ * up, so the visitor sees the fallback panel and the retry replays the row.
+ * Correct, but ugly — and the fail-open posture (P10/D11) only helps if it
+ * answers inside the site's budget.
+ *
+ * `Promise.race` against a timer: a timeout is treated EXACTLY like a rejection
+ * by every caller (fail open on the trip check and the counter, fire anyway on
+ * the alarm dedupe). The timer is cleared when the call settles so an answered
+ * command leaves nothing behind; a call that loses the race keeps running to
+ * completion in the background and its eventual rejection is already handled
+ * (`Promise.race` subscribes to every input).
+ */
+
+/** One second: well under the website server action's own budget, well over a healthy round trip. */
+export const WEBSITE_REDIS_TIMEOUT_MS = 1_000;
+
+export class WebsiteRedisTimeoutError extends Error {
+  constructor(op: string, ms: number) {
+    super(`redis ${op} timed out after ${ms} ms`);
+    this.name = 'WebsiteRedisTimeoutError';
+  }
+}
+
+export function withRedisTimeout<T>(op: string, run: () => Promise<T>, ms: number = WEBSITE_REDIS_TIMEOUT_MS): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(new WebsiteRedisTimeoutError(op, ms)), ms);
+  });
+  // `Promise.resolve().then(run)`: a synchronous throw inside `run` becomes a rejection too.
+  return Promise.race([Promise.resolve().then(run), timeout]).finally(() => {
+    if (timer) clearTimeout(timer);
+  });
+}
