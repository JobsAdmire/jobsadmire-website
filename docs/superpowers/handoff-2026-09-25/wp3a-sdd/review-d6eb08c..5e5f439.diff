+    expect([...new Set(newsletterTemplates)].sort()).toEqual(['website-newsletter-confirm', 'website-newsletter-welcome']);
+  });
+
+  it('the WEBSITE_FORMS_UNAVAILABLE registry entry names website-forms-unavailable', () => {
+    expect(EVENT_REGISTRY.WEBSITE_FORMS_UNAVAILABLE.emailTemplate).toBe('website-forms-unavailable');
+  });
+
+  it.each([
+    'website-newsletter-confirm',
+    'website-newsletter-welcome',
+    'website-forms-unavailable',
+  ])('%s.hbs and %s.tr.hbs exist and are not empty', (name) => {
+    for (const file of [`${name}.hbs`, `${name}.tr.hbs`]) {
+      const path = join(TEMPLATES_DIR, file);
+      expect({ file, exists: existsSync(path) }).toEqual({ file, exists: true });
+      expect({ file, bytes: readFileSync(path, 'utf8').trim().length > 0 }).toEqual({ file, bytes: true });
+    }
+  });
+
+  it('the names this spec pins are the ones the services use (no drift between the two lists)', () => {
+    const pinned = ['website-newsletter-confirm', 'website-newsletter-welcome', 'website-forms-unavailable'];
+    const used = [...new Set([...newsletterTemplates, EVENT_REGISTRY.WEBSITE_FORMS_UNAVAILABLE.emailTemplate])];
+    expect(used.sort()).toEqual(pinned.sort());
+  });
+});
