+  return [...source.matchAll(/template:\s*'([a-z0-9-]+)'/g)].map((m) => m[1]);
+}
+
+describe('website module — every named .hbs template ships on disk in both locales', () => {
+  const newsletterTemplates = templatesNamedIn(readFileSync(NEWSLETTER_SERVICE, 'utf8'));
+
