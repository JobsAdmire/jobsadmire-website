+// apps/backend/src/modules/website/website-redis-timeout.spec.ts
+/**
+ * The bounded wait for the door's Redis calls (final-review Minor 6): a hung
+ * command answers as a rejection after WEBSITE_REDIS_TIMEOUT_MS, a fast one
+ * passes through untouched, and a synchronous throw is a rejection too.
+ */
+import { withRedisTimeout, WebsiteRedisTimeoutError, WEBSITE_REDIS_TIMEOUT_MS } from './website-redis-timeout';
+
+describe('withRedisTimeout', () => {
+  afterEach(() => { jest.useRealTimers(); });
+
+  it('passes a settled call through, value and rejection alike', async () => {
+    await expect(withRedisTimeout('exists', async () => true)).resolves.toBe(true);
+    await expect(withRedisTimeout('exists', async () => { throw new Error('redis down'); })).rejects.toThrow('redis down');
+    await expect(withRedisTimeout('exists', (() => { throw new Error('sync'); }) as never)).rejects.toThrow('sync');
+  });
+
+  it('rejects a hung call after WEBSITE_REDIS_TIMEOUT_MS (1 s) with a named error', async () => {
+    jest.useFakeTimers();
+    expect(WEBSITE_REDIS_TIMEOUT_MS).toBe(1_000);
+    const hung = withRedisTimeout('incr', () => new Promise<number>(() => undefined));
+    const settled = jest.fn();
+    hung.then(settled, settled);
+    await jest.advanceTimersByTimeAsync(999);
+    expect(settled).not.toHaveBeenCalled();
+    await jest.advanceTimersByTimeAsync(1);
+    await expect(hung).rejects.toBeInstanceOf(WebsiteRedisTimeoutError);
+    expect(settled).toHaveBeenCalledTimes(1);
+    expect((settled.mock.calls[0][0] as Error).message).toBe('redis incr timed out after 1000 ms');
+  });
+
+  it('clears its timer once the call settles — nothing keeps the loop alive', async () => {
+    jest.useFakeTimers();
+    await withRedisTimeout('setNx', async () => true);
+    expect(jest.getTimerCount()).toBe(0);
+  });
+});
