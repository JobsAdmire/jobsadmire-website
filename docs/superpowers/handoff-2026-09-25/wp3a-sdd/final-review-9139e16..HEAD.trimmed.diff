+
+  it('messagePreview is capped at 5000 characters and notes at 2000 (CreateInquiryDto caps are not enforced on a service call)', () => {
+    const dto = buildWebsiteInquiryDto(input({ fields: { name: 'A', message: 'x'.repeat(6000) } }));
