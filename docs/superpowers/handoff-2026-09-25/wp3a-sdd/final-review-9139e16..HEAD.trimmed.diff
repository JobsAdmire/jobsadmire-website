+
+  it('a PENDING address that asks again within 15 minutes is answered CONFIRMATION_SENT without a second mail (X12 cooldown)', async () => {
+    // Issue time is derived, not stored: confirmExpiresAt − NEWSLETTER_CONFIRM_TTL_MS.
+    const issuedFiveMinutesAgo = new Date(Date.now() - 5 * 60 * 1000 + NEWSLETTER_CONFIRM_TTL_MS);
+    const { svc, store, notifications, prisma } = makeService([
