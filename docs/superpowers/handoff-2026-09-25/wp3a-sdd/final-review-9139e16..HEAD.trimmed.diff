+    ]);
+    await expect(svc.subscribe({ ...SUB, email: 'a@b.io' })).resolves.toEqual({ subscriberId: 'sub_9', outcome: 'CONFIRMATION_SENT' });
+    expect(store[0].confirmTokenHash).not.toBe('old');
