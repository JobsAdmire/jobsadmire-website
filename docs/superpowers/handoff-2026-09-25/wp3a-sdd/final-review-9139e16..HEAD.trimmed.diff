+  @IsOptional()
+  @IsString()
+  @MaxLength(500)
+  turnstileSecret?: string;
+
+  @ApiPropertyOptional({ description: 'Shared secret Operations presents to the website revalidate route (Phase B consumer). Empty string clears.' })
