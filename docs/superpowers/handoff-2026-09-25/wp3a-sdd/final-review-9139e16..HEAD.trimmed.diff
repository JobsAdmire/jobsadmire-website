+import * as nodemailer from 'nodemailer';
+import { google } from 'googleapis';
+
+import { GoogleWorkspaceConfigService } from '../integrations/google-workspace-config.service';
+import { EmailService } from './email.service';
+import { IrEmailConfigService, type ResolvedIrEmailConfig } from './ir-email-config.service';
+
+/**
+ * Custom RFC-822 headers (WP3a Task 9): `headers` must reach BOTH transports —
+ * the Gmail raw-MIME builder and nodemailer — or RFC 8058 one-click
+ * unsubscribe silently vanishes on one path. Same harness as
+ * email.service.spec.ts for the EmailService routing cells; below them, the
+ * three wire-format cells drive the real transports' last step (MailComposer
+ * for Gmail, nodemailer `sendMail` for both SMTP transporters) and read the
+ * header lines back.
+ *
+ * `nodemailer` (the main entry) is mocked so no transporter is ever created;
+ * `nodemailer/lib/mail-composer` is a different module id and stays REAL —
+ * the Gmail cell needs the genuine MIME builder to prove `headers` is the
+ * option MailComposer honours.
+ */
+jest.mock('nodemailer', () => ({ createTransport: jest.fn() }));
+jest.mock('googleapis', () => ({ google: { gmail: jest.fn() } }));
+
+function makeEmailService(opts: {
+  resolved: unknown;
+  gmailEnabled?: boolean;
+  sendGmail?: jest.Mock;
+  sendViaSmtp?: jest.Mock;
+  /** Set to give EmailService a global SMTP transporter (the mocked createTransport). */
+  smtpHost?: string;
+}) {
+  const config = { get: (k: string, d: unknown) => (k === 'SMTP_HOST' && opts.smtpHost ? opts.smtpHost : d) } as never;
+  const sendGmail = opts.sendGmail ?? jest.fn().mockResolvedValue({ messageId: 'gmail' });
+  const googleConfig = {
+    sendGmail,
+    getConfigRow: jest.fn().mockResolvedValue({ gmailEnabled: opts.gmailEnabled ?? true }),
+  } as never;
+  const sendViaSmtp = opts.sendViaSmtp ?? jest.fn().mockResolvedValue({ messageId: 'smtp' });
+  const irEmailConfig = {
+    getResolvedSafe: jest.fn().mockResolvedValue(opts.resolved),
+    from: (c: { senderName: string; senderEmail: string }) => `${c.senderName} <${c.senderEmail}>`,
+    sendViaSmtp,
+  } as never;
+  return { svc: new EmailService(config, googleConfig, irEmailConfig), sendGmail, sendViaSmtp };
+}
+
+const headers = {
+  'List-Unsubscribe': '<https://www.jobsadmire.com/abonelikten-cik?token=x.y>, <mailto:info@jobsadmire.com?subject=unsubscribe>',
+  'List-Unsubscribe-Post': 'List-Unsubscribe=One-Click',
+};
+
+/** RFC 5322 §2.2.3: a long header is folded as CRLF + WSP; unfold before reading it back. */
+const unfold = (mime: string) => mime.replace(/\r?\n[ \t]+/g, ' ');
+
+describe('EmailService custom headers', () => {
+  it('default mailbox (prod: SMTP_HOST unset → Gmail impersonated) forwards headers to sendGmail', async () => {
+    const { svc, sendGmail } = makeEmailService({ resolved: null });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {}, mailbox: 'default', headers });
+    expect(sendGmail).toHaveBeenCalledWith(expect.objectContaining({ fromImpersonated: true, headers }));
+  });
+
+  it('careers mailbox on the IR SMTP transport forwards headers to sendViaSmtp', async () => {
+    const { svc, sendViaSmtp } = makeEmailService({
+      resolved: { isActive: true, transport: 'SMTP', senderName: 'C', senderEmail: 'careers@jobsadmire.com' },
