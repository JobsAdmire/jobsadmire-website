+++ b/apps/backend/src/modules/website/website-purge.cron.spec.ts
@@ -0,0 +1,176 @@
+// apps/backend/src/modules/website/website-purge.cron.spec.ts
+/**
+ * The 90-day purge (P10; RC5): rows whose `purgeAfter` has passed are deleted
+ * in batches; a FRAUD_REPORT row's private objects (payloadJson.fields.
+ * evidenceKeys, read through WebsiteFraudEvidenceService.evidenceKeysOf) go
+ * FIRST, and a row with ANY object that could not be removed is kept for the
+ * next night — a deleted pointer to a surviving object is an orphan nobody
+ * will ever sweep.
+ *
+ * The ORPHAN SWEEP (execution ruling): a visitor uploads evidence and never
+ * submits the form, so the object has no row and no purgeAfter. Every
+ * `website-fraud/` object older than 7 days that no submission's
+ * `payloadJson.fields.evidenceKeys` references is removed — the referenced
+ * set is ONE query over the FRAUD_REPORT-kind rows (test rows included);
+ * counts only in the log.
+ */
+import { WebsitePurgeCron } from './website-purge.cron';
+import { WEBSITE_MODULE_ENABLED_ENV } from './website-module-flag';
+
+type Row = { id: string; payloadJson: unknown };
+type Obj = { key: string; lastModified: Date | null };
+
+function make(
+  opts: { enabled?: boolean; rows?: Row[]; gone?: (key: string) => boolean; objects?: Obj[]; fraudRows?: Row[] } = {},
+) {
+  const rows = [...(opts.rows ?? [])];
+  const prisma = {
+    websiteFormSubmission: {
+      // The purge reads rows past purgeAfter (batched); the orphan sweep reads
+      // every FRAUD_REPORT-kind row's payload in one query.
+      findMany: jest.fn(async (args: { where: Record<string, unknown> }) =>
+        'purgeAfter' in args.where ? rows.splice(0, 100) : [...(opts.fraudRows ?? [])],
+      ),
+      deleteMany: jest.fn(async (_a: unknown) => ({ count: 0 })),
+    },
+  };
+  const upload = {
+    deleteFileChecked: jest.fn(async (key: string) => (opts.gone ? opts.gone(key) : true)),
+    listObjects: jest.fn(async (_prefix: string) => opts.objects ?? []),
+  };
+  const config = { get: jest.fn((k: string) => (k === WEBSITE_MODULE_ENABLED_ENV ? String(opts.enabled ?? true) : undefined)) };
+  return { cron: new WebsitePurgeCron(prisma as never, upload as never, config as never), prisma, upload };
+}
+
+const NOW = new Date('2026-12-20T04:30:00.000Z');
+const daysAgo = (n: number) => new Date(NOW.getTime() - n * 24 * 60 * 60 * 1000);
+const plain = (id: string): Row => ({ id, payloadJson: { fields: { name: 'A', email: 'a@b.c' } } });
+const fraud = (id: string, keys: string[]): Row => ({ id, payloadJson: { fields: { description: 'x', evidenceKeys: keys } } });
+const SWEEP_QUERY = { where: { form: { kind: 'FRAUD_REPORT' } }, select: { payloadJson: true } };
+
+describe('WebsitePurgeCron', () => {
+  it('skips the sweep while the module flag is off', async () => {
+    const { cron, prisma, upload } = make({ enabled: false, rows: [plain('s1')], objects: [{ key: 'website-fraud/x.jpg', lastModified: daysAgo(30) }] });
+    await cron.run(NOW);
+    expect(prisma.websiteFormSubmission.findMany).not.toHaveBeenCalled();
+    expect(upload.listObjects).not.toHaveBeenCalled();
+  });
+
+  it('selects only rows whose purgeAfter has passed, oldest first, in batches of 100, reading the payload', async () => {
+    const { cron, prisma } = make({ rows: [plain('s1')] });
+    await cron.run(NOW);
+    expect(prisma.websiteFormSubmission.findMany).toHaveBeenCalledWith({
+      where: { purgeAfter: { lte: NOW } },
+      select: { id: true, payloadJson: true },
+      orderBy: { purgeAfter: 'asc' },
+      take: 100,
+    });
+    expect(prisma.websiteFormSubmission.deleteMany).toHaveBeenCalledWith({ where: { id: { in: ['s1'] } } });
+  });
+
+  it('deletes every private object before the row that points at them', async () => {
+    const { cron, prisma, upload } = make({ rows: [fraud('s2', ['website-fraud/abc.jpg', 'website-fraud/def.pdf'])] });
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).toHaveBeenCalledWith('website-fraud/abc.jpg');
+    expect(upload.deleteFileChecked).toHaveBeenCalledWith('website-fraud/def.pdf');
+    expect(upload.deleteFileChecked.mock.invocationCallOrder[1]).toBeLessThan(prisma.websiteFormSubmission.deleteMany.mock.invocationCallOrder[0]);
+    expect(prisma.websiteFormSubmission.deleteMany).toHaveBeenCalledWith({ where: { id: { in: ['s2'] } } });
+  });
+
+  it('keeps a row with any object that could not be removed, so tomorrow retries it', async () => {
+    const { cron, prisma } = make({
+      rows: [fraud('s3', ['website-fraud/ok.jpg', 'website-fraud/stuck.jpg']), plain('s4')],
+      gone: (key) => !key.includes('stuck'),
+    });
+    await cron.run(NOW);
+    expect(prisma.websiteFormSubmission.deleteMany).toHaveBeenCalledWith({ where: { id: { in: ['s4'] } } });
+  });
+
+  it('ignores keys outside the website-fraud/ prefix — a hand-edited row cannot aim the purge at another bucket path', async () => {
+    const { cron, upload } = make({ rows: [fraud('s5', ['careers-cv/x.pdf'])] });
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).not.toHaveBeenCalled();
+  });
+
+  it('does nothing, quietly, when nothing is due', async () => {
+    const { cron, prisma } = make({ rows: [] });
+    await cron.run(NOW);
+    expect(prisma.websiteFormSubmission.deleteMany).not.toHaveBeenCalled();
+  });
+
+  it('never throws out of the tick', async () => {
+    const { cron, prisma } = make();
+    prisma.websiteFormSubmission.findMany.mockRejectedValueOnce(new Error('db down'));
+    await expect(cron.run(NOW)).resolves.toBeUndefined();
+  });
+});
+
+describe('WebsitePurgeCron — fraud-orphan sweep', () => {
+  it('removes website-fraud/ objects older than 7 days that no submission references, and nothing else', async () => {
+    const { cron, prisma, upload } = make({
+      objects: [
+        { key: 'website-fraud/orphan.jpg', lastModified: daysAgo(8) },
+        { key: 'website-fraud/fresh.jpg', lastModified: daysAgo(1) },
+        { key: 'website-fraud/live.pdf', lastModified: daysAgo(30) },
+        { key: 'website-fraud/undated.jpg', lastModified: null },
+      ],
+      fraudRows: [fraud('f1', ['website-fraud/live.pdf', 'website-fraud/other.jpg'])],
+    });
+    await cron.run(NOW);
+    expect(upload.listObjects).toHaveBeenCalledWith('website-fraud/');
+    // ONE query for the referenced set — every FRAUD_REPORT row's payload.
+    expect(prisma.websiteFormSubmission.findMany).toHaveBeenCalledWith(SWEEP_QUERY);
+    expect(prisma.websiteFormSubmission.findMany.mock.calls.filter(([a]) => 'form' in (a as { where: object }).where)).toHaveLength(1);
+    expect(upload.deleteFileChecked).toHaveBeenCalledTimes(1);
+    expect(upload.deleteFileChecked).toHaveBeenCalledWith('website-fraud/orphan.jpg');
+  });
+
+  it('keeps an object a TEST submission references — a heartbeat row is still a row', async () => {
+    const { cron, upload } = make({
+      objects: [{ key: 'website-fraud/test-ref.jpg', lastModified: daysAgo(30) }],
+      fraudRows: [fraud('f-test', ['website-fraud/test-ref.jpg'])],
+    });
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).not.toHaveBeenCalled();
+  });
+
+  it('does not query the database at all when no object is old enough', async () => {
+    const { cron, prisma } = make({ objects: [{ key: 'website-fraud/fresh.jpg', lastModified: daysAgo(1) }] });
+    await cron.run(NOW);
+    expect(prisma.websiteFormSubmission.findMany).not.toHaveBeenCalledWith(SWEEP_QUERY);
+  });
+
+  it('exactly seven days old is not yet an orphan; a day more is', async () => {
+    const sevenDays = 7 * 24 * 60 * 60 * 1000;
+    const { cron, upload } = make({
+      objects: [
+        { key: 'website-fraud/edge.jpg', lastModified: new Date(NOW.getTime() - sevenDays) },
+        { key: 'website-fraud/over.jpg', lastModified: new Date(NOW.getTime() - sevenDays - 1) },
+      ],
+    });
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).toHaveBeenCalledTimes(1);
+    expect(upload.deleteFileChecked).toHaveBeenCalledWith('website-fraud/over.jpg');
+  });
+
+  it('never touches a listed key that is not under website-fraud/ — the listing is trusted only inside the prefix', async () => {
+    const { cron, upload } = make({ objects: [{ key: 'careers-cv/x.pdf', lastModified: daysAgo(30) }] });
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).not.toHaveBeenCalled();
+  });
+
+  it('runs AFTER the row purge and survives a listing failure', async () => {
+    const { cron, prisma, upload } = make({ rows: [plain('s1')] });
+    upload.listObjects.mockRejectedValueOnce(new Error('minio down'));
+    await expect(cron.run(NOW)).resolves.toBeUndefined();
+    expect(prisma.websiteFormSubmission.deleteMany).toHaveBeenCalledWith({ where: { id: { in: ['s1'] } } });
+    expect(prisma.websiteFormSubmission.deleteMany.mock.invocationCallOrder[0]).toBeLessThan(upload.listObjects.mock.invocationCallOrder[0]);
+  });
+
+  it('still sweeps orphans when the row purge itself failed', async () => {
+    const { cron, prisma, upload } = make({ objects: [{ key: 'website-fraud/orphan.jpg', lastModified: daysAgo(8) }] });
+    prisma.websiteFormSubmission.findMany.mockRejectedValueOnce(new Error('db down'));
+    await cron.run(NOW);
+    expect(upload.deleteFileChecked).toHaveBeenCalledWith('website-fraud/orphan.jpg');
+  });
+});
diff --git a/apps/backend/src/modules/website/website-purge.cron.ts b/apps/backend/src/modules/website/website-purge.cron.ts
new file mode 100644
index 0000000..ed5655f
--- /dev/null
+++ b/apps/backend/src/modules/website/website-purge.cron.ts
@@ -0,0 +1,169 @@
+// apps/backend/src/modules/website/website-purge.cron.ts
+import { Injectable, Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { Cron } from '@nestjs/schedule';
+import { WebsiteFormKind } from '@prisma/client';
+import { PrismaService } from '../../prisma/prisma.service';
+import { UploadService } from '../upload/upload.service';
+import { FRAUD_EVIDENCE_KEY_PREFIX } from './fraud-evidence-file';
+import { WebsiteFraudEvidenceService } from './website-fraud-evidence.service';
+import { websiteModuleEnabled } from './website-module-flag';
+
+const BATCH_SIZE = 100;
+/** Ceiling per night, so a backlog is a few nights of work rather than one long transaction. */
+const MAX_BATCHES = 20;
+/**
+ * A `website-fraud/` object with no submission row is an upload the visitor
+ * never followed with a form (or a row the purge above already removed). It
+ * gets a week: long enough for the slowest form session and for a re-run of a
+ * FAILED fraud row, short enough that the private bucket never accumulates
+ * strangers' screenshots.
+ */
+export const WEBSITE_FRAUD_ORPHAN_AGE_MS = 7 * 24 * 60 * 60 * 1000;
+
+/**
+ * The website door's 90-day purge (WP3a, P10; D11: `purgeAfter` = 90 days
+ * after HANDLED, set by the core's `runHandler`). Daily at 04:30 UTC —
+ * deliberately not 03:00, which is `CareersRetentionCron`'s slot
+ * (`EVERY_DAY_AT_3AM`), so the two sweeps never share a minute of MinIO and
+ * Postgres.
+ *
+ * HARD DELETE of the submission row: `payloadJson` IS the personal data
+ * (names, phones, e-mails, a fraud report's evidence), and everything the
+ * business keeps — the Inquiry, the applicant, the subscriber — is its own
+ * row with its own retention. A FRAUD_REPORT row names up to three private
+ * objects under `website-fraud/` in `payloadJson.fields.evidenceKeys` (RC5;
+ * read through `WebsiteFraudEvidenceService.evidenceKeysOf`, which re-applies
+ * the prefix lock) that nothing else references, so the objects go FIRST with
+ * `deleteFileChecked`, and a row with ANY object that could not be removed is
+ * KEPT for the next night: deleting the pointer would leave an orphan no
+ * sweep can find.
+ *
+ * THE ORPHAN SWEEP runs second: every `website-fraud/` object older than
+ * `WEBSITE_FRAUD_ORPHAN_AGE_MS` that no submission's
+ * `payloadJson.fields.evidenceKeys` references is removed. The referenced set
+ * is ONE query: every FRAUD_REPORT-kind row's payload (RC5 — the fraud
+ * catalog is the only one that defines `evidenceKeys`, and the 90-day purge
+ * above bounds that population), test rows included, read through
+ * `evidenceKeysOf`; the query is skipped when no object is old enough. The
+ * log carries counts only; an object key is a visitor's private file name.
+ *
+ * `WebsiteSubscriber` is not purged here: an UNSUBSCRIBED row is the proof we
+ * honoured the request, and a CONFIRMED one is live consent.
+ *
+ * Reads the module flag per tick (P1). Never throws; each arm has its own
+ * try/catch so a database outage does not stop the sweep, nor the reverse.
+ */
+@Injectable()
+export class WebsitePurgeCron {
+  private readonly logger = new Logger(WebsitePurgeCron.name);
+  private running = false;
+
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly upload: UploadService,
+    private readonly config: ConfigService,
+  ) {}
+
+  @Cron('0 30 4 * * *', { name: 'website-purge' })
+  async tick(): Promise<void> {
+    if (this.running) return;
+    this.running = true;
+    try {
+      await this.run(new Date());
+    } finally {
+      this.running = false;
+    }
+  }
+
+  async run(now: Date): Promise<void> {
+    if (!websiteModuleEnabled(this.config)) {
+      this.logger.log('website purge skipped — the website module is off');
+      return;
+    }
+    await this.purgeRows(now);
+    await this.sweepOrphans(now);
+  }
+
+  private async purgeRows(now: Date): Promise<void> {
+    let deleted = 0;
+    let kept = 0;
+    let objects = 0;
+    try {
+      for (let batch = 0; batch < MAX_BATCHES; batch += 1) {
+        const rows = await this.prisma.websiteFormSubmission.findMany({
+          where: { purgeAfter: { lte: now } },
+          select: { id: true, payloadJson: true },
+          orderBy: { purgeAfter: 'asc' },
+          take: BATCH_SIZE,
+        });
+        if (rows.length === 0) break;
+
+        const deletable: string[] = [];
+        for (const row of rows) {
+          const keys = WebsiteFraudEvidenceService.evidenceKeysOf(row.payloadJson);
+          let allGone = true;
+          for (const key of keys) {
+            const gone = await this.upload.deleteFileChecked(key);
+            if (gone) objects += 1;
+            else allGone = false;
+          }
+          if (allGone) deletable.push(row.id);
+          else kept += 1;
+        }
+        if (deletable.length) {
+          await this.prisma.websiteFormSubmission.deleteMany({ where: { id: { in: deletable } } });
+          deleted += deletable.length;
+        }
+        // Every row in this batch was kept: the next read returns the same rows.
+        if (deletable.length === 0 || rows.length < BATCH_SIZE) break;
+      }
+      if (deleted || kept) {
+        this.logger.log(`website purge — deleted ${deleted} submission(s) past purgeAfter, removed ${objects} object(s), kept ${kept} whose object could not be removed`);
+      }
+    } catch (err) {
+      this.logger.error(`website purge failed: ${(err as Error)?.message}`);
+    }
+  }
+
+  private async sweepOrphans(now: Date): Promise<void> {
+    let removed = 0;
+    let referenced = 0;
+    let stuck = 0;
+    try {
+      const cutoff = now.getTime() - WEBSITE_FRAUD_ORPHAN_AGE_MS;
+      const objects = await this.upload.listObjects(FRAUD_EVIDENCE_KEY_PREFIX);
+      // The listing is trusted only inside the prefix, and an undated object
+      // cannot be judged old.
+      const candidates = objects.filter(
+        (obj) => obj.key.startsWith(FRAUD_EVIDENCE_KEY_PREFIX) && obj.lastModified !== null && obj.lastModified.getTime() < cutoff,
+      );
+      if (candidates.length === 0) return;
+
+      // One query for the referenced set — every fraud row, whether or not
+      // its purgeAfter has come, whether or not it is a test row.
+      const rows = await this.prisma.websiteFormSubmission.findMany({
+        where: { form: { kind: WebsiteFormKind.FRAUD_REPORT } },
+        select: { payloadJson: true },
+      });
+      const referencedKeys = new Set<string>();
+      for (const row of rows) {
+        for (const key of WebsiteFraudEvidenceService.evidenceKeysOf(row.payloadJson)) referencedKeys.add(key);
+      }
+
+      for (const obj of candidates) {
+        if (referencedKeys.has(obj.key)) {
+          referenced += 1;
+          continue;
+        }
+        if (await this.upload.deleteFileChecked(obj.key)) removed += 1;
+        else stuck += 1;
+      }
+      if (removed || referenced || stuck) {
+        this.logger.log(`website fraud-orphan sweep — removed ${removed} object(s) older than 7 days with no submission, ${referenced} still referenced, ${stuck} could not be removed`);
+      }
+    } catch (err) {
+      this.logger.error(`website fraud-orphan sweep failed: ${(err as Error)?.message}`);
+    }
+  }
+}
diff --git a/apps/backend/src/modules/website/website-schema.spec.ts b/apps/backend/src/modules/website/website-schema.spec.ts
