+  it('the VPS default is the production site (www)', () => {
+    expect(fs.readFileSync(path.join(root, 'docker-compose.vps.yml'), 'utf8')).toMatch(
+      /WEBSITE_SITE_URL: \$\{WEBSITE_SITE_URL:-https:\/\/www\.jobsadmire\.com\}/,
+    );
