@@ -0,0 +1,163 @@
+import * as nodemailer from 'nodemailer';
+import { google } from 'googleapis';
+
+import { GoogleWorkspaceConfigService } from '../integrations/google-workspace-config.service';
+import { EmailService } from './email.service';
+import { IrEmailConfigService, type ResolvedIrEmailConfig } from './ir-email-config.service';
+
+/**
+ * Custom RFC-822 headers (WP3a Task 9): `headers` must reach BOTH transports —
+ * the Gmail raw-MIME builder and nodemailer — or RFC 8058 one-click
+ * unsubscribe silently vanishes on one path. Same harness as
+ * email.service.spec.ts for the EmailService routing cells; below them, the
+ * three wire-format cells drive the real transports' last step (MailComposer
+ * for Gmail, nodemailer `sendMail` for both SMTP transporters) and read the
+ * header lines back.
+ *
+ * `nodemailer` (the main entry) is mocked so no transporter is ever created;
+ * `nodemailer/lib/mail-composer` is a different module id and stays REAL —
+ * the Gmail cell needs the genuine MIME builder to prove `headers` is the
+ * option MailComposer honours.
+ */
+jest.mock('nodemailer', () => ({ createTransport: jest.fn() }));
+jest.mock('googleapis', () => ({ google: { gmail: jest.fn() } }));
+
+function makeEmailService(opts: {
+  resolved: unknown;
+  gmailEnabled?: boolean;
+  sendGmail?: jest.Mock;
+  sendViaSmtp?: jest.Mock;
+  /** Set to give EmailService a global SMTP transporter (the mocked createTransport). */
+  smtpHost?: string;
+}) {
+  const config = { get: (k: string, d: unknown) => (k === 'SMTP_HOST' && opts.smtpHost ? opts.smtpHost : d) } as never;
+  const sendGmail = opts.sendGmail ?? jest.fn().mockResolvedValue({ messageId: 'gmail' });
+  const googleConfig = {
+    sendGmail,
+    getConfigRow: jest.fn().mockResolvedValue({ gmailEnabled: opts.gmailEnabled ?? true }),
+  } as never;
+  const sendViaSmtp = opts.sendViaSmtp ?? jest.fn().mockResolvedValue({ messageId: 'smtp' });
+  const irEmailConfig = {
+    getResolvedSafe: jest.fn().mockResolvedValue(opts.resolved),
+    from: (c: { senderName: string; senderEmail: string }) => `${c.senderName} <${c.senderEmail}>`,
+    sendViaSmtp,
+  } as never;
+  return { svc: new EmailService(config, googleConfig, irEmailConfig), sendGmail, sendViaSmtp };
+}
+
+const headers = {
+  'List-Unsubscribe': '<https://www.jobsadmire.com/abonelikten-cik?token=x.y>, <mailto:info@jobsadmire.com?subject=unsubscribe>',
+  'List-Unsubscribe-Post': 'List-Unsubscribe=One-Click',
+};
+
+/** RFC 5322 §2.2.3: a long header is folded as CRLF + WSP; unfold before reading it back. */
+const unfold = (mime: string) => mime.replace(/\r?\n[ \t]+/g, ' ');
+
+describe('EmailService custom headers', () => {
+  it('default mailbox (prod: SMTP_HOST unset → Gmail impersonated) forwards headers to sendGmail', async () => {
+    const { svc, sendGmail } = makeEmailService({ resolved: null });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {}, mailbox: 'default', headers });
+    expect(sendGmail).toHaveBeenCalledWith(expect.objectContaining({ fromImpersonated: true, headers }));
+  });
+
+  it('careers mailbox on the IR SMTP transport forwards headers to sendViaSmtp', async () => {
+    const { svc, sendViaSmtp } = makeEmailService({
+      resolved: { isActive: true, transport: 'SMTP', senderName: 'C', senderEmail: 'careers@jobsadmire.com' },
+    });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {}, mailbox: 'careers', headers });
+    expect(sendViaSmtp).toHaveBeenCalledWith(expect.anything(), expect.objectContaining({ headers }));
+  });
+
+  it('careers mailbox on Gmail forwards headers to sendGmail', async () => {
+    const { svc, sendGmail } = makeEmailService({
+      resolved: { isActive: true, transport: 'GMAIL', senderName: 'C', senderEmail: 'careers@jobsadmire.com' },
+    });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {}, mailbox: 'careers', headers });
+    expect(sendGmail).toHaveBeenCalledWith(expect.objectContaining({ headers }));
+  });
+
+  it('the global SMTP transporter (SMTP_HOST set) gets headers on sendMail', async () => {
+    const sendMail = jest.fn().mockResolvedValue({ messageId: 'global-smtp' });
+    (nodemailer.createTransport as jest.Mock).mockReturnValue({ sendMail });
+    const { svc, sendGmail } = makeEmailService({ resolved: null, smtpHost: 'smtp.example.test' });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {}, headers });
+    expect(sendGmail).not.toHaveBeenCalled();
+    expect(sendMail).toHaveBeenCalledWith(expect.objectContaining({ to: 'a@b.io', headers }));
+  });
+
+  it('no headers → nothing is added to the transport call', async () => {
+    const { svc, sendGmail } = makeEmailService({ resolved: null });
+    await svc.sendEmail({ to: 'a@b.io', subject: 's', template: 't', context: {} });
+    expect(sendGmail.mock.calls[0][0]).not.toHaveProperty('headers');
+  });
+});
+
+describe('custom headers reach the wire format', () => {
+  it('IR SMTP: sendViaSmtp hands headers to nodemailer sendMail beside the threading headers', async () => {
+    const sendMail = jest.fn().mockResolvedValue({ messageId: '<relay-1@jobsadmire.com>' });
+    (nodemailer.createTransport as jest.Mock).mockReturnValue({ sendMail });
+    const svc = new IrEmailConfigService({} as never, { get: (_k: string, d: unknown) => d } as never, {} as never);
+    const cfg = {
+      isActive: true,
+      transport: 'SMTP',
+      senderName: 'JobsAdmire Careers',
+      senderEmail: 'careers@jobsadmire.com',
+      replyTo: 'careers@jobsadmire.com',
+      smtpHost: 'smtp-relay.gmail.com',
+      smtpPort: 587,
+      smtpSecure: false,
+      smtpUser: 'admin@jobsadmire.com',
+      smtpPass: 'pw',
+    } as unknown as ResolvedIrEmailConfig;
+    await svc.sendViaSmtp(cfg, { to: 'a@b.io', subject: 's', html: '<p>x</p>', inReplyTo: '<in@b.io>', headers }, { cached: false });
+    const arg = sendMail.mock.calls[0][0];
+    expect(arg.headers).toEqual(headers);
+    expect(arg.inReplyTo).toBe('<in@b.io>'); // threading untouched
+    // Without headers, nodemailer sees no `headers` key at all.
+    sendMail.mockClear();
+    await svc.sendViaSmtp(cfg, { to: 'a@b.io', subject: 's', html: '<p>x</p>' }, { cached: false });
+    expect(sendMail.mock.calls[0][0]).not.toHaveProperty('headers');
+  });
+
+  it('Gmail: sendGmail emits the header lines in the raw MIME it submits (real MailComposer)', async () => {
+    const send = jest.fn().mockResolvedValue({ data: { id: 'gmail-1', threadId: null } });
+    (google.gmail as jest.Mock).mockReturnValue({ users: { messages: { send } } });
+    const svc = new GoogleWorkspaceConfigService({} as never, { get: (_k: string, d: unknown) => d } as never);
+    jest.spyOn(svc, 'getConfigRow').mockResolvedValue({
+      gmailEnabled: true,
+      impersonatedUser: 'info@jobsadmire.com',
+      senderName: 'JobsAdmire',
+      senderEmail: 'careers@jobsadmire.com',
+    } as never);
+    jest.spyOn(svc, 'getAuthClient').mockResolvedValue({} as never);
+
+    await svc.sendGmail({
+      to: 'a@b.io',
+      subject: 'Please confirm',
+      html: '<p>x</p>',
+      fromImpersonated: true,
+      inReplyTo: '<in@b.io>',
+      headers,
+    });
+
+    const raw: string = send.mock.calls[0][0].requestBody.raw;
+    const mime = unfold(Buffer.from(raw.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'));
+    expect(mime).toContain(`List-Unsubscribe: ${headers['List-Unsubscribe']}`);
+    expect(mime).toContain('List-Unsubscribe-Post: List-Unsubscribe=One-Click');
+    expect(mime).toContain('In-Reply-To: <in@b.io>'); // threading untouched
+    expect(mime).toContain('From: JobsAdmire <info@jobsadmire.com>');
+  });
+
+  it('the real MailComposer folds nothing away: both header names survive without `headers` being misspelt', async () => {
+    // Guards the option name itself — a typo (`header`, `customHeaders`) would
+    // be silently ignored by MailComposer and every cell above would still pass.
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const MailComposer = require('nodemailer/lib/mail-composer');
+    const built: Buffer = await new MailComposer({ from: 'a@b.io', to: 'c@d.io', subject: 's', html: '<p>x</p>', headers })
+      .compile()
+      .build();
+    const mime = unfold(built.toString('utf8'));
+    expect(mime.match(/^List-Unsubscribe: /m)).not.toBeNull();
+    expect(mime.match(/^List-Unsubscribe-Post: List-Unsubscribe=One-Click$/m)).not.toBeNull();
+  });
+});
